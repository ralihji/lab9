{
  "info": {
    "name": "SEG3502 Lab 9 : Temperature Converter (Basic Auth)",
    "description": "Vérifie que chaque requête à l'API exige l'authentification Basic. Importable dans Postman et Insomnia. Démarrer l'API avec ./gradlew bootRun avant d'envoyer les requêtes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Sans identifiants",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/temperature-converter/celsius-fahrenheit/50",
          "host": [
            "{{host}}"
          ],
          "path": [
            "temperature-converter",
            "celsius-fahrenheit",
            "50"
          ]
        },
        "description": "401 attendu",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 attendu', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('En-tête WWW-Authenticate: Basic', function () {",
              "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Basic');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Mauvais mot de passe (user1 / wrong)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/temperature-converter/celsius-fahrenheit/50",
          "host": [
            "{{host}}"
          ],
          "path": [
            "temperature-converter",
            "celsius-fahrenheit",
            "50"
          ]
        },
        "description": "401 attendu",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "user1",
              "type": "string"
            },
            {
              "key": "password",
              "value": "wrong",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 attendu', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('En-tête WWW-Authenticate: Basic', function () {",
              "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Basic');",
              "});"
            ]
          }
        }
      ]
    },
