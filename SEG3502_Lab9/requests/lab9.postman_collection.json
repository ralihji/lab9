        },
        "description": "200 attendu, réponse 122.0",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "user1",
              "type": "string"
            },
            {
              "key": "password",
              "value": "pass1",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
